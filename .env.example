# Local development (npm run dev). Keep this file private.
PORT=3001
HOST=127.0.0.1
DATA_DIR=server/data
# Local development stays on SQLite until the Supabase database is configured.
# Then set DATABASE_DRIVER=postgres and paste your private connection string.
# Use Supabase Connect > Session pooler (port 5432), or a direct connection.
# No Supabase anon/publishable/service-role API key is needed by this backend.
DATABASE_DRIVER=sqlite
DATABASE_URL=
DATABASE_SSL=verify-full
DATABASE_POOL_MODE=session
DATABASE_POOL_SIZE=10
# Optional provider CA certificate path. TLS certificate verification stays on.
DATABASE_CA_FILE=
APP_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001,http://localhost:3001
REGISTRATION_ENABLED=true
# Razorpay TEST credentials. A plan must be INR 150000 paise, monthly, interval 1.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# Production: DATABASE_DRIVER=postgres, NODE_ENV=production, HOST=0.0.0.0
# Set APP_ORIGIN=https://your-domain and use an HTTPS reverse proxy.
# DATA_DIR only stores local SQLite files. See server/SUPABASE.md for hosting.
