{
  "name": "smart-retail-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --configLoader native --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env --import ./scripts/register-ts.mjs server/index.mjs",
    "start": "node --env-file-if-exists=.env --import ./scripts/register-ts.mjs server/index.mjs",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "db:install": "npm install --prefix server/postgres-runtime",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.mjs migrate",
    "db:check": "node --env-file-if-exists=.env scripts/database.mjs check",
    "db:import": "node --env-file-if-exists=.env --import ./scripts/register-ts.mjs scripts/import-sqlite.mjs",
    "test:postgres": "node --import ./scripts/register-ts.mjs --test tests/postgres.integration.test.mjs",
    "test": "node --import ./scripts/register-ts.mjs --test tests/domain.test.mjs tests/backend.test.mjs tests/dev.test.mjs tests/storage.test.mjs",
    "test:e2e": "npm run build && node --import ./scripts/register-ts.mjs scripts/e2e.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.15.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
